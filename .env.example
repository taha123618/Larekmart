# ==============================================================================
# Larekmart Microservices — Global Docker & Environment Configuration
# ==============================================================================

# Core Application Execution Mode
NODE_ENV=production

# Base Domains & Edge Routing (Traefik Ingress)
DOMAIN=localhost
CLIENT_DOMAIN=shop.localhost
STORE_DOMAIN=larekmart.localhost
ADMIN_DOMAIN=admin.localhost
API_DOMAIN=api.localhost
APP_DOMAIN=app.localhost
LOGS_DOMAIN=logs.localhost
DOZZLE_DOMAIN=logs.localhost
KAFKA_UI_DOMAIN=kafka.localhost
GRAFANA_DOMAIN=monitoring.localhost
TRAEFIK_DASHBOARD_DOMAIN=traefik.localhost

# Security Hardening: Network Bind IP Configuration
# In production, internal services and databases bind to 127.0.0.1 (loopback)
# to strictly prevent direct external internet exposure. Only Traefik (80/443) binds 0.0.0.0.
DB_BIND_IP=127.0.0.1
INTERNAL_SERVICE_BIND_IP=127.0.0.1
API_GATEWAY_BIND_IP=127.0.0.1
CLIENT_BIND_IP=127.0.0.1
ADMIN_BIND_IP=127.0.0.1
DEV_TOOLS_BIND_IP=127.0.0.1
KAFKA_BIND_IP=127.0.0.1
LOGS_BIND_IP=127.0.0.1
CADDY_BIND_IP=127.0.0.1
TRAEFIK_DASHBOARD_BIND_IP=127.0.0.1

# Host Port Mappings (Overridable)
API_GATEWAY_PORT=8090
CLIENT_PORT=3002
ADMIN_PORT=3003
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8088
DOZZLE_PORT=8888
LOGS_PORT=8085
CADDY_HTTP_PORT=8086
CADDY_HTTPS_PORT=8443
TRIVY_PORT=4954

# Traefik Edge Router & SSL Configuration
ACME_EMAIL=admin@larekmart.com
TRAEFIK_LOG_LEVEL=INFO

# Core Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=product_db
POSTGRES_MULTIPLE_DATABASES=product_db,inventory_db,catalog_db,shipping_db,analytics_db,notification_db,recommendation_db,user_db,media_db

# MongoDB & Mongo Express Configuration
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
ME_CONFIG_BASICAUTH_USERNAME=mongoexpressuser
ME_CONFIG_BASICAUTH_PASSWORD=mongoexpresspass

# OpenSearch Cluster Configuration
OPENSEARCH_INITIAL_ADMIN_PASSWORD=SecurePassword123!

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_admin_secret

# Trivy Security Scanner Configuration
TRIVY_TOKEN=change_me_to_a_secure_token
TRIVY_DEBUG=false

# MinIO Object Storage Configuration
MINIO_ROOT_USER=changemeuser
MINIO_ROOT_PASSWORD=changemepass

# Rootprint & Quickwit Telemetry Configuration
ROOTPRINT_ORIGIN=http://localhost:8282
ROOTPRINT_DB_USER=rootprint
ROOTPRINT_DB_PASSWORD=rootprint
ROOTPRINT_DB_NAME=rootprint
QW_S3_ENDPOINT=http://minio:9000

# CI/CD & External Security Tooling Credentials
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token_or_pat
SNYK_TOKEN=your_snyk_api_token
