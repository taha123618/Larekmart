NODE_ENV=development
PORT=8013

# PostgreSQL — source of truth for media metadata
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/media_db

# Redis — cache, rate limiting, upload-session state, processing locks. Never source of truth.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=media:v1:
MEDIA_CACHE_TTL_SECONDS=60

# Kafka — media lifecycle events
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
KAFKA_CLIENT_ID=media-service
KAFKA_GROUP_ID=media-service-group

# S3-compatible object storage (MinIO in development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MEDIA_PRESIGN_EXPIRY_SECONDS=900

# Upload limits per category (bytes)
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_UPLOAD_LIMITS={"avatar":2097152,"product-image":10485760,"review-image":5242880,"seller-document":26214400,"marketing-image":10485760,"video":524288000}

# Image processing
MEDIA_VARIANTS=thumbnail:160,small:480,medium:960,large:1600
MEDIA_WORKER_POLL_INTERVAL_MS=2000
MEDIA_WORKER_MAX_ATTEMPTS=3
# PROCESSING jobs whose started_at is older than this are requeued as crashed
MEDIA_WORKER_STALE_JOB_SECONDS=900
MEDIA_CLEANUP_INTERVAL_MS=300000
MEDIA_UPLOAD_SESSION_TTL_SECONDS=86400

# Ownership
MEDIA_OWNER_TYPES=product,seller,user,review,category,brand,collection,marketing

# Auth (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Observability
LOG_LEVEL=info
OTEL_SERVICE_NAME=media-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Development auth bypass (never enable in production): accepts x-user-id /
# x-user-role headers as the verified identity for local testing without Clerk keys.
MEDIA_DEV_AUTH_BYPASS=false
CLIENT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
INTERNAL_SERVICE_SECRET=dev-shared-internal-secret-larekmart
MEDIA_RATE_LIMIT_UPLOAD_CREATE=30
MEDIA_RATE_LIMIT_UPLOAD_COMPLETE=60
MEDIA_RATE_LIMIT_URL=300
MEDIA_RATE_LIMIT_DELETE=30
MEDIA_RATE_LIMIT_ADMIN=120

