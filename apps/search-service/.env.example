NODE_ENV=development
PORT=8006
HOST=0.0.0.0

# OpenSearch Configuration (use https://localhost:9200 for secure compose, http:// for security-disabled compose)
OPENSEARCH_NODE=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX=products-v1
OPENSEARCH_ALIAS=products
OPENSEARCH_REQUEST_TIMEOUT=5000

# Redis Configuration (Cache & Rate Limiting)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=search:v1:
SEARCH_CACHE_TTL_SECONDS=300
SUGGESTION_CACHE_TTL_SECONDS=600

# Kafka Configuration
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
KAFKA_GROUP_ID=search-service-group
KAFKA_CLIENT_ID=search-service

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Observability
LOG_LEVEL=info
OTEL_SERVICE_NAME=search-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
CLIENT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
