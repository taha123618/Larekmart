NODE_ENV=development
PORT=8026
# Runtime connection via PgBouncer (transaction pooling)
DATABASE_URL=postgresql://postgres:admin123@localhost:6432/chat_db?schema=public&pgbouncer=true&statement_cache_size=0
# Direct connection for Prisma migrations
DIRECT_URL=postgresql://postgres:admin123@localhost:5432/chat_db?schema=public
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
INTERNAL_SERVICE_SECRET=YOUR_INTERNAL_SECRET
CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLIENT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
API_GATEWAY_URL=http://localhost:8080
LOG_LEVEL=info
