{
  "name": "chat-service",
  "version": "1.0.0",
  "description": "Larekmart Chat Service: Real-time buyer-to-seller messaging, customer support chat transport, Socket.IO Redis adapter, and Drizzle PostgreSQL message store",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --env-file-if-exists=.env tests/unit/chat.unit.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env tests/integration/chat.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:deploy": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@repo/kafka": "workspace:*",
    "@repo/monitoring": "workspace:*",
    "@repo/redis": "workspace:*",
    "@repo/types": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.5.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.15.4",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
