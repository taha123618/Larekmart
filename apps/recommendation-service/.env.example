APP_NAME=recommendation-service
APP_ENV=development
PORT=8008
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=["http://localhost:3002","http://localhost:3003"]

# PostgreSQL with pgvector
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/recommendation_db

# Redis Caching
REDIS_URL=redis://localhost:6379/0

# Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9094,localhost:9095,localhost:9096
KAFKA_CONSUMER_GROUP=recommendation-service

# Celery Background Processing
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OpenTelemetry Tracing
OTEL_SERVICE_NAME=recommendation-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Caching & Tuning
RECOMMENDATION_CACHE_TTL=300
DEFAULT_RECOMMENDATION_LIMIT=10
