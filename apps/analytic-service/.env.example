PORT=8004
DATABASE_URL="postgresql://postgres:your_password@localhost:5433/analytics_db"
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Redis (dashboard read-through cache; optional — the API falls back to PostgreSQL)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=analytics:v1:
ANALYTICS_CHART_CACHE_TTL_SECONDS=60
ANALYTICS_EVENTS_CACHE_TTL_SECONDS=15
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
# Consumer thread scale must be strictly <= KAFKA_NUM_PARTITIONS to prevent worker starvation and rebalance storms
KAFKA_NUM_PARTITIONS=3
ANALYTICS_WORKER_COUNT=3
# Defensive micro-batching into ClickHouse & PostgreSQL (minimum 10,000+ rows per block)
ANALYTICS_BATCH_SIZE=10000
ANALYTICS_QUEUE_CAPACITY=50000
ANALYTICS_FLUSH_INTERVAL_MS=500
CLIENT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
INTERNAL_SERVICE_SECRET=dev-shared-internal-secret-larekmart


#Click House 
CLICKHOUSE_URL="http://default:clickhouse123@localhost:8123/analytics_db"
CLICKHOUSE_ENABLED=true
