PORT=8009
NODE_ENV=development
MONGO_URL=mongodb://root:example@localhost:27017/ecommerce?authSource=admin
# Reconcile MongoDB indexes with the Mongoose schemas on connect. unset = on everywhere
# except production; true = also in production; false = never (see packages/cart-db).
MONGO_SYNC_INDEXES=
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=cart:v1:
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_CLIENT_ID=cart-service
KAFKA_GROUP_ID=cart-service-group
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
PRODUCT_SERVICE_URL=http://localhost:8000
INVENTORY_SERVICE_URL=http://localhost:8007
GUEST_CART_TTL_SECONDS=604800
USER_CART_TTL_SECONDS=2592000
CART_CACHE_TTL_SECONDS=300
INTERNAL_SERVICE_SECRET=your_internal_service_secret_here
