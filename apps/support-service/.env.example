REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
INTERNAL_SERVICE_SECRET=dev_gateway_secret_change_in_production
GATEWAY_INTERNAL_SECRET=dev_gateway_secret_change_in_production

