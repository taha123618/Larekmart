PORT=8011
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/larekmart_shipping_db?schema=public"
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="shipping:v1:"
KAFKA_BROKERS="localhost:9094,localhost:9095,localhost:9096"
KAFKA_CLIENT_ID="shipping-service"
KAFKA_GROUP_ID="shipping-service-group"
SHIPPING_RATE_CACHE_TTL_SECONDS=1800
TRACKING_CACHE_TTL_SECONDS=300
DEFAULT_CARRIER="custom"
# REQUIRED in every shared/production environment. Requests signed with the
# built-in placeholder value are always rejected.
WEBHOOK_SECRET=""
INTERNAL_SERVICE_SECRET=dev-shared-internal-secret-larekmart
CLIENT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

