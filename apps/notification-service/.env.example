# Notification Service Configuration
APP_ENV=development
HTTP_PORT=8005

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/larekmart_notification_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis (Caching & Idempotency)
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=notification:
IDEMPOTENCY_TTL=24h

# Kafka
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
KAFKA_GROUP_ID=notification-service-group
KAFKA_TOPIC_PREFIX=
KAFKA_CONSUMER_TOPICS=user.created,order.created,payment.successful,notification.dispatch

# Email Integration (email-service / direct SMTP fallback)
EMAIL_SERVICE_ENABLED=true
EMAIL_KAFKA_DISPATCH=true

# SMS Provider Configuration (e.g. twilio, mock)
SMS_PROVIDER=mock
SMS_API_KEY=mock-sms-api-key
SMS_SENDER_NUMBER=+1234567890

#for twillio 
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications Configuration (e.g. fcm, apns, mock)
PUSH_PROVIDER=mock
PUSH_API_KEY=mock-push-api-key

# WebSocket & CORS
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003
WEBSOCKET_PING_INTERVAL=30s
WEBSOCKET_WRITE_WAIT=10s

# Worker Pools
WORKER_CONCURRENCY_EMAIL=5
WORKER_CONCURRENCY_SMS=5
WORKER_CONCURRENCY_PUSH=5
WORKER_CONCURRENCY_INAPP=10
WORKER_MAX_RETRIES=3
WORKER_INITIAL_BACKOFF_MS=500

# OpenTelemetry & Observability
OTEL_SERVICE_NAME=notification-service
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_ENABLED=false
LOG_LEVEL=debug
LOG_FORMAT=json
