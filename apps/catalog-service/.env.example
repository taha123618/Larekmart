PORT=8010
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/catalog_db?schema=public"
# Read Replica connection pool (optional; defaults to DATABASE_URL if omitted)
# When multiplexing over PgBouncer in transaction mode on port 6432, append &pgbouncer=true&statement_cache_size=0 to disable prepared statement caching
DATABASE_READ_REPLICA_URL="postgresql://postgres:your_password@localhost:6432/catalog_db?schema=public&pgbouncer=true&statement_cache_size=0"
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="catalog:v1:"
KAFKA_BROKERS="localhost:9094,localhost:9095,localhost:9096"
KAFKA_CLIENT_ID="catalog-service"
KAFKA_GROUP_ID="catalog-service-group"
CATALOG_CACHE_TTL_SECONDS=3600
CLIENT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
