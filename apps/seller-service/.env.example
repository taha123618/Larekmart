NODE_ENV=development
PORT=8021
# Runtime connection via PgBouncer (transaction pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/seller_db?schema=public&pgbouncer=true&statement_cache_size=0
# Direct connection for Prisma migrations
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/seller_db?schema=public
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
INTERNAL_SERVICE_SECRET=dev-internal-secret-change-in-production
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
