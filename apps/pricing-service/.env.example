PORT=8019
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:password123@localhost:5432/larekmart_pricing_db

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379
PRICING_CACHE_TTL_SECONDS=3600

# Kafka Event Broker
KAFKA_BROKERS=localhost:9092,localhost:9094,localhost:9096
KAFKA_CLIENT_ID=pricing-service
KAFKA_GROUP_ID=pricing-service-group

# Clerk Authentication & Security
CLERK_PUBLISHABLE_KEY=pk_test_mock_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_mock_clerk_secret_key
INTERNAL_SERVICE_SECRET=dev-shared-internal-secret-larekmart

# Inter-Service Integrations
PROMOTION_SERVICE_URL=http://localhost:8016
TAX_SERVICE_URL=http://localhost:8017
