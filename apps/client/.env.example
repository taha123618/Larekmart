NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Centralized API Gateway (Authoritative Single Entry Point for all services)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8090
NEXT_PUBLIC_NOTIFICATION_WS_URL=ws://localhost:8090/ws

# Server-side runtime API Gateway URL (overrides compile-time NEXT_PUBLIC_API_GATEWAY_URL for browser routing)
# Used by /api/config endpoint to serve runtime config to the browser client.
# In Docker/Kubernetes: set to the internal service URL (e.g. http://api-gateway:8080)
CLIENT_API_GATEWAY_URL=http://localhost:8090
CLIENT_WS_URL=ws://localhost:8090/ws
