PORT=8018
NODE_ENV=development
HOST=0.0.0.0

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=mysql_root_password_123
MYSQL_DATABASE=return_db
DATABASE_URL=mysql://root:mysql_root_password_123@127.0.0.1:3307/return_db

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379
RETURN_CACHE_TTL_SECONDS=3600

# Kafka Event Broker
KAFKA_BROKERS=localhost:9092,localhost:9094,localhost:9096
KAFKA_CLIENT_ID=return-service
KAFKA_GROUP_ID=return-service-group

# Internal Gateway Shared Secret
GATEWAY_INTERNAL_SECRET=dev-shared-internal-secret-larekmart

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_mock_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_mock_clerk_secret_key

# Transactional Outbox Worker
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# Downstream Microservices & Security
TAX_SERVICE_URL=http://localhost:8017
SHIPPING_SERVICE_URL=http://localhost:8011
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003
