# return-service environment configuration
PORT=8018
NODE_ENV=development

# MySQL Database
DATABASE_URL=mysql://root:mysql_root_password_123@localhost:3306/return_db

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379

# Kafka Event Broker
KAFKA_BROKERS=localhost:9092,localhost:9094,localhost:9096
KAFKA_CLIENT_ID=return-service
KAFKA_GROUP_ID=return-service-group

# Internal Gateway Secret for Signed Headers
GATEWAY_INTERNAL_SECRET=dev_internal_gateway_secret_2026

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_mock_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_mock_clerk_publishable_key

# Related Service URLs (for client/admin reference)
TAX_SERVICE_URL=http://localhost:8017
SHIPPING_SERVICE_URL=http://localhost:8011
