NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/

# Centralized API Gateway (Authoritative Single Entry Point for all services)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8090
NEXT_PUBLIC_CLIENT_URL=http://localhost:3002
NEXT_PUBLIC_NOTIFICATION_WS_URL=ws://localhost:8090/ws
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Admin self-promotion bootstrap (POST /api/claim-admin). DISABLED unless
# ALLOW_ADMIN_CLAIM=true AND a strong ADMIN_REGISTRATION_SECRET is set.
# Never add a NEXT_PUBLIC_* variant of the claim secret — it would be embedded
# in the client bundle served to every visitor.
ALLOW_ADMIN_CLAIM=false
ADMIN_REGISTRATION_SECRET=
