PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/product_db
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...


# OpenSearch (use https://localhost:9200 for secure compose, http:// for security-disabled compose)
OPENSEARCH_NODE=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_ALIAS=products
OPENSEARCH_REQUEST_TIMEOUT=5000

# Redis (catalog read-through cache; optional — the service falls back to PostgreSQL)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=product:v1:
PRODUCT_CACHE_TTL_SECONDS=300
CATEGORY_CACHE_TTL_SECONDS=300
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
