NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_db
CLERK_SECRET_KEY=

# OpenSearch (read-only access to the shared product search index)
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_ALIAS=products
OPENSEARCH_REQUEST_TIMEOUT=5000

# Redis (catalog read-through cache; optional — the service falls back to PostgreSQL)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=product:v1:
PRODUCT_CACHE_TTL_SECONDS=300
CATEGORY_CACHE_TTL_SECONDS=300
