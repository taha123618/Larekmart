NODE_ENV=development
PORT=8007
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/larekmart_inventory_db
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=inventory:v1:
INVENTORY_CACHE_TTL_SECONDS=30
RESERVATION_EXPIRY_SWEEP_INTERVAL_MS=60000
KAFKA_GROUP_ID=inventory-service-group
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
# Stripe paid-session verification for payment.successful events (required
# for the Kafka consumer to confirm reservations).
STRIPE_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
LOG_LEVEL=info
OTEL_SERVICE_NAME=inventory-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
