PORT=8001
MONGO_URL=mongodb://root:example@localhost:27017/order_db?authSource=admin
# Sharded cluster / Replica set connection pool parameters:
MONGO_READ_PREFERENCE=primaryPreferred
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=5
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
INTERNAL_SERVICE_SECRET=dev-shared-internal-secret-larekmart


# Reconcile MongoDB indexes with the Mongoose schemas on connect. unset = on everywhere
# except production; true = also in production; false = never (see packages/order-db).
MONGO_SYNC_INDEXES=

# Redis (order-chart read-through cache; optional — the service falls back to MongoDB)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=order:v1:
ORDER_CHART_CACHE_TTL_SECONDS=60
KAFKA_BROKERS=localhost:9094,localhost:9095,localhost:9096
CLIENT_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003
