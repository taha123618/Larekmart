{
  "name": "vendor-service",
  "version": "1.0.0",
  "description": "Larekmart Vendor Service: legal entities, KYB verification, documents & lifecycle management",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "check-types": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --env-file-if-exists=.env tests/vendor-service.test.ts && NODE_ENV=test tsx --env-file-if-exists=.env tests/settlements.test.ts && NODE_ENV=test tsx --env-file-if-exists=.env tests/disputes.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@repo/kafka": "workspace:*",
    "@repo/monitoring": "workspace:*",
    "@repo/redis": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/vendor-db": "workspace:*",
    "fastify": "^4.28.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.13.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
