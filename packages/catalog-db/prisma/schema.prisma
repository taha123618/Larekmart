generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AvailabilityStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum CollectionStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model CatalogBrand {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  logoUrl     String?
  description String?
  isActive    Boolean          @default(true)
  products    CatalogProduct[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive])
}

model CatalogCategory {
  id              String                   @id @default(uuid())
  parentId        String?
  parent          CatalogCategory?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children        CatalogCategory[]        @relation("CategoryHierarchy")
  name            String
  slug            String                   @unique
  description     String?
  image           String?
  position        Int                      @default(0)
  isActive        Boolean                  @default(true)
  primaryProducts CatalogProduct[]         @relation("PrimaryCategoryProducts")
  products        CatalogCategoryProduct[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([parentId, position])
  @@index([isActive])
}

model CatalogProduct {
  id                 String                     @id @default(uuid())
  productId          String                     @unique
  name               String
  slug               String                     @unique
  shortDescription   String?
  description        String?
  brandId            String?
  brand              CatalogBrand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  primaryCategoryId  String?
  primaryCategory    CatalogCategory?           @relation("PrimaryCategoryProducts", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  thumbnailUrl       String
  images             Json                       @default("{}")
  price              Float
  compareAtPrice     Float?
  discountPercentage Float                      @default(0)
  rating             Float                      @default(0)
  reviewCount        Int                        @default(0)
  availabilityStatus AvailabilityStatus         @default(IN_STOCK)
  isFeatured         Boolean                    @default(false)
  isNew              Boolean                    @default(false)
  isActive           Boolean                    @default(true)
  tags               String[]                   @default([])
  publishedAt        DateTime?                  @default(now())
  variants           CatalogProductVariant[]
  categoryProducts   CatalogCategoryProduct[]
  collectionProducts CatalogCollectionProduct[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([primaryCategoryId, isActive])
  @@index([brandId, isActive])
  @@index([isFeatured, isActive])
  @@index([isNew, isActive])
  @@index([price])
  @@index([rating])
}

model CatalogProductVariant {
  id        String         @id @default(uuid())
  productId String
  product   CatalogProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)
  variantId String
  size      String         @default("")
  color     String         @default("")
  sku       String?
  price     Float
  inStock   Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@unique([productId, variantId])
}

model CatalogCollection {
  id                 String                     @id @default(uuid())
  name               String
  slug               String                     @unique
  description        String?
  imageUrl           String?
  status             CollectionStatus           @default(ACTIVE)
  sortOrder          Int                        @default(0)
  startAt            DateTime?
  endAt              DateTime?
  collectionProducts CatalogCollectionProduct[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([status, sortOrder])
}

model CatalogCollectionProduct {
  id           String            @id @default(uuid())
  collectionId String
  collection   CatalogCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      CatalogProduct    @relation(fields: [productId], references: [productId], onDelete: Cascade)
  position     Int               @default(0)
  createdAt    DateTime          @default(now())

  @@unique([collectionId, productId])
  @@index([collectionId, position])
}

model CatalogCategoryProduct {
  id         String          @id @default(uuid())
  categoryId String
  category   CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productId  String
  product    CatalogProduct  @relation(fields: [productId], references: [productId], onDelete: Cascade)
  position   Int             @default(0)
  createdAt  DateTime        @default(now())

  @@unique([categoryId, productId])
  @@index([categoryId, position])
}

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}
