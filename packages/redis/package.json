{
  "name": "@repo/redis",
  "version": "0.0.1",
  "description": "Shared Redis client factory, cache helpers, and rate-limiting utilities for Larekmart microservices",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
