generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  READY_TO_SHIP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  RETURNED
  LOST
}

model Shipment {
  id                  String             @id @default(uuid())
  orderId             String
  userId              String?
  carrier             String
  serviceType         String             @default("standard")
  trackingNumber      String?            @unique
  status              ShipmentStatus     @default(PENDING)
  shippingAddress     Json
  shippingRateAmount  Int                @default(0)
  currency            String             @default("PKR")
  isCod               Boolean            @default(false)
  codAmount           Int?
  codFee              Int?               @default(0)
  codStatus           String?            // PENDING_COLLECTION, COLLECTED, REMITTED, REFUSED
  estimatedDeliveryAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  metadata            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  items               ShipmentItem[]
  packages            ShipmentPackage[]
  labels              ShippingLabel[]
  trackingEvents      TrackingEvent[]
  deliveryAttempts    DeliveryAttempt[]

  @@index([orderId])
  @@index([userId])
  @@index([carrier, status])
  @@index([status])
  @@index([isCod, codStatus])
  @@index([createdAt])
}

model ShipmentItem {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  productId  String
  name       String
  quantity   Int      @default(1)
  price      Int      @default(0)
  weight     Float?
  sku        String?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

model ShipmentPackage {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  weight      Float
  length      Float?
  width       Float?
  height      Float?
  packageType String   @default("box")
  createdAt   DateTime @default(now())

  @@index([shipmentId])
}

model ShippingMethod {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  carrier          String
  description      String?
  isActive         Boolean  @default(true)
  baseRate         Int      @default(0)
  estimatedDaysMin Int      @default(1)
  estimatedDaysMax Int      @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([carrier, isActive])
}

model TrackingEvent {
  id          String         @id @default(uuid())
  shipmentId  String
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  description String
  location    String?
  occurredAt  DateTime       @default(now())
  source      String         @default("manual") // carrier_webhook, carrier_poll, manual
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([shipmentId, occurredAt])
}

model ShippingLabel {
  id             String   @id @default(uuid())
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrier        String
  trackingNumber String
  format         String   @default("pdf")
  labelUrl       String
  cost           Int?
  createdAt      DateTime @default(now())

  @@index([shipmentId])
  @@index([trackingNumber])
}

model DeliveryAttempt {
  id            String   @id @default(uuid())
  shipmentId    String
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  attemptNumber Int      @default(1)
  attemptedAt   DateTime @default(now())
  status        String   @default("failed") // failed, rescheduled, delivered
  reason        String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([shipmentId])
}

model ShippingWebhook {
  id              String    @id @default(uuid())
  carrier         String
  externalEventId String?
  signature       String?
  payload         Json
  status          String    @default("received") // received, processed, ignored, failed
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([carrier, externalEventId])
  @@index([status])
}

model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@index([eventType])
}

model CarrierAccount {
  id              String   @id @default(uuid())
  carrier         String   @unique
  accountNumber   String?
  apiKeyEncrypted String?
  isActive        Boolean  @default(true)
  isTestMode      Boolean  @default(true)
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
