{
  "name": "larekmart",
  "version": "1.0.0",
  "description": "Production-grade microservices e-commerce platform built with Next.js 15, Kafka, Fastify, Go, Python, and Turborepo.",
  "license": "MIT",
  "homepage": "https://github.com/taha123618/Larekmart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taha123618/Larekmart.git"
  },
  "keywords": [
    "microservices",
    "ecommerce",
    "nextjs",
    "kafka",
    "turborepo",
    "fastify",
    "express",
    "hono",
    "kubernetes",
    "docker",
    "opensearch",
    "redis",
    "postgresql",
    "mongodb",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "// build": "=== Build & Code Quality ===",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "// format": "Format the project with Prettier",
    "format": "prettier --write \"**/*.{ts,tsx,md,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,js,json}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "// db": "=== Database & Kafka ===",
    "kafka:init-topics": "pnpm --filter @repo/kafka topics:init",
    "db:generate": "turbo run db:generate",
    "db:migrate": "node scripts/db-migrate.js --action=migrate",
    "db:deploy": "node scripts/db-migrate.js --action=deploy",
    "db:status": "node scripts/db-migrate.js --action=status",
    "db:seed": "pnpm --filter @repo/product-db db:seed",
    "// setup": "=== Setup & Environment ===",
    "install:all": "pnpm install",
    "env:setup": "node scripts/setup-env.js",
    "skills:sync": "node scripts/sync-skills.js",
    "setup": "pnpm install && node scripts/setup-env.js && node scripts/sync-skills.js",
    "// monitoring": "=== Grafana + Prometheus Monitoring ===",
    "monitoring:up": "docker compose -f docker-compose.observability.yml up -d",
    "monitoring:down": "docker compose -f docker-compose.observability.yml down",
    "monitoring:logs": "docker compose -f docker-compose.observability.yml logs -f",
    "// security": "=== Trivy Security Scanner ===",
    "trivy:up": "docker compose -f docker-compose.security.yml up -d",
    "trivy:down": "docker compose -f docker-compose.security.yml down",
    "// rootprint": "=== Rootprint + Quickwit + MinIO Log Analytics (Best for STAGING & PRODUCTION)===",
    "rootprint:up": "docker compose -f docker-compose.rootprint.yml up -d",
    "rootprint:down": "docker compose -f docker-compose.rootprint.yml down",
    "rootprint:logs": "docker compose -f docker-compose.rootprint.yml logs -f",
    "// k8s": "=== Kubernetes & GitOps ===",
    "k8s:dev": "kubectl apply -k infrastructure/kubernetes/overlays/development",
    "k8s:staging": "kubectl apply -k infrastructure/kubernetes/overlays/staging",
    "k8s:validate": "kubectl kustomize infrastructure/kubernetes/overlays/production",
    "argocd:bootstrap": "kubectl apply -f infrastructure/argocd/project.yaml && kubectl apply -f infrastructure/argocd/root-app.yaml",
    "// iac": "=== Infrastructure as Code (Terraform & Ansible) ===",
    "terraform:fmt": "terraform -chdir=infrastructure/terraform fmt -recursive",
    "terraform:plan:dev": "terraform -chdir=infrastructure/terraform plan -var-file=environments/dev/terraform.tfvars",
    "terraform:plan:prod": "terraform -chdir=infrastructure/terraform plan -var-file=environments/prod/terraform.tfvars",
    "ansible:syntax-check": "ansible-playbook -i infrastructure/ansible/inventories/production/hosts.ini infrastructure/ansible/playbooks/site.yml --syntax-check",
    "docker:scout": "bash scripts/docker-scout-audit.sh",
    "test:staging:traffic": "bash scripts/verify-staging-traffic.sh",
    "// proxies": "=== Reverse Proxies & Ingress (Traefik, Dozzle, Caddy) ===",
    "traefik:up": "docker compose -f docker-compose.traefik.yml up -d",
    "traefik:down": "docker compose -f docker-compose.traefik.yml down",
    "traefik:logs": "docker compose -f docker-compose.traefik.yml logs -f",
    "// dozzle": "=== Live Container Logs Stack (Dozzle + Nginx Reverse Proxy) (Best for LOCAL DEVELOPMENT)===",
    "dozzle:up": "docker compose -f docker-compose.dozzle.yml up -d",
    "dozzle:down": "docker compose -f docker-compose.dozzle.yml down",
    "dozzle:logs": "docker compose -f docker-compose.dozzle.yml logs -f",
    "caddy:up": "docker compose -f docker-compose.caddy.yml up -d",
    "caddy:down": "docker compose -f docker-compose.caddy.yml down",
    "caddy:logs": "docker compose -f docker-compose.caddy.yml logs -f"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
