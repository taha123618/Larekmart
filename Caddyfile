# ==============================================================================
# Larekmart Production Caddy Reverse Proxy Configuration
# ==============================================================================

{
    # Global options
    admin off
    auto_https off
}

# ──────────────────────────────────────────────────────────────────────────────
# Main Gateway Block (Port 80)
# ──────────────────────────────────────────────────────────────────────────────
:80 {
    # Modern compression for all responses
    encode zstd gzip

    # Defensive Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Health Check Endpoint
    respond /healthz "healthy" 200

    # 1. Larekmart API Gateway (/api/*)
    handle /api/* {
        reverse_proxy api-gateway:8090 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
            transport http {
                keepalive 30s
                keepalive_idle_conns 100
            }
        }
    }

    # 2. Next.js Admin Dashboard (/admin/*)
    handle /admin/* {
        reverse_proxy admin:3003 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 3. Next.js Storefront Client (/shop/*)
    handle /shop/* {
        reverse_proxy client:3002 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 4. Container Logs - Dozzle (/logs/*)
    handle_path /logs/* {
        reverse_proxy dozzle:8888 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            # Flush immediately for real-time Server-Sent Events (SSE) streaming logs
            flush_interval -1
        }
    }

    # 5. Observability - Grafana (/grafana/*)
    handle_path /grafana/* {
        reverse_proxy grafana:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 6. Log Analytics - Rootprint (/rootprint/*)
    handle_path /rootprint/* {
        reverse_proxy rootprint:8282 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 7. Default Fallback -> Larekmart API Gateway
    handle {
        reverse_proxy api-gateway:8090 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
