{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "ADMIN_REGISTRATION_SECRET",
    "ALLOW_ADMIN_CLAIM",
    "STRIPE_SECRET_KEY",
    "INTERNAL_API_GATEWAY_URL",
    "API_GATEWAY_URL",
    "INTERNAL_WS_URL"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "ADMIN_REGISTRATION_SECRET",
    "ALLOW_ADMIN_CLAIM",
    "STRIPE_SECRET_KEY",
    "INTERNAL_API_GATEWAY_URL",
    "API_GATEWAY_URL",
    "INTERNAL_WS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "bin/**"],
      "env": [
        "DATABASE_URL",
        "NODE_ENV",
        "ADMIN_REGISTRATION_SECRET",
        "ALLOW_ADMIN_CLAIM",
        "STRIPE_SECRET_KEY",
        "INTERNAL_API_GATEWAY_URL",
        "API_GATEWAY_URL",
        "INTERNAL_WS_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["NODE_ENV", "ADMIN_REGISTRATION_SECRET", "ALLOW_ADMIN_CLAIM"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    }
  }
}
