{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "ADMIN_REGISTRATION_SECRET"],
  "globalPassThroughEnv": ["NODE_ENV", "ADMIN_REGISTRATION_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "bin/**"],
      "env": ["DATABASE_URL", "NODE_ENV", "ADMIN_REGISTRATION_SECRET"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["NODE_ENV", "ADMIN_REGISTRATION_SECRET"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    }
  }
}
