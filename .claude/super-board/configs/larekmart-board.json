{
  "version": 1,
  "description": "Larekmart autonomous GitHub project board",
  "project": {
    "owner": "taha123618",
    "title": "Larekmart board",
    "number": 2
  },
  "worker_backend": "workflow",
  "model_tier": "medium",
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/taha123618/Larekmart.git"
  },
  "base_branch": "staging",
  "timezone": "Asia/Karachi",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": ["qa", "bug", "feature"],
  "paths": {
    "project_md": null,
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "auto",
    "auto_max_lines": 400,
    "size_exclude": [
      "**/package-lock.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/bun.lockb",
      "**/bun.lock",
      "**/npm-shrinkwrap.json",
      "**/Cargo.lock",
      "**/poetry.lock",
      "**/uv.lock",
      "**/Pipfile.lock",
      "**/Gemfile.lock",
      "**/composer.lock",
      "**/go.sum",
      "**/Podfile.lock",
      "**/pubspec.lock",
      "**/generated/**",
      "**/__generated__/**",
      "**/*.generated.*",
      "**/*.gen.*",
      "**/*.min.js",
      "**/*.min.css",
      "**/*.map",
      "**/*.pb.go",
      "**/*_pb2.py",
      "**/__snapshots__/**",
      "**/*.snap"
    ],
    "always_human": {
      "money": {
        "labels": ["money", "payments", "billing", "pricing"],
        "paths": [
          "**/billing/**",
          "**/payments/**",
          "**/stripe/**",
          "**/checkout/**"
        ],
        "keywords": ["stripe.", "payment_intent", "price_id", "invoice.create"]
      },
      "auth": {
        "labels": ["auth", "security"],
        "paths": ["**/auth/**", "**/authz/**", "**/permissions/**"],
        "keywords": ["jwt.sign", "bcrypt", "password_hash", "service_role"]
      },
      "schema": {
        "labels": ["schema", "destructive"],
        "paths": [],
        "keywords": [
          "drop table",
          "drop column",
          "truncate table",
          "rename column",
          "drop schema"
        ]
      }
    },
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": [
      "supabase/migrations/**",
      "prisma/migrations/**",
      "packages/*/prisma/migrations/**",
      "drizzle/**",
      "**/migrations/*.sql",
      "db/migrate/**",
      "alembic/versions/**"
    ],
    "allowed_envs": ["test", "staging"],
    "target_env": "staging",
    "commands": {
      "test": "pnpm db:migrate",
      "staging": "pnpm db:deploy"
    },
    "checks": {},
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "max_dispatches": 0,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "verify_commands": ["pnpm check-types", "pnpm test"],
  "usage_pause_pct": 95,
  "usage_fallback": "none",
  "max_workers": 0,
  "rebuild_cap": 2,
  "block_rate_alert_pct": 30,
  "notifications": {
    "bot_identity": "taha123618"
  },
  "collect": {
    "sources": ["github", "prs", "architecture"],
    "window_days": 14
  }
}
